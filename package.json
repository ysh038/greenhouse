{
  "name": "agent-greenhouse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "check": "node scripts/check.mjs",
    "peers": "pnpm peers check",
    "typecheck": "tsc -b",
    "lint": "eslint . --ignore-pattern '**/fixtures/**' --max-warnings 0 && stylelint '**/*.css' --ignore-pattern '**/fixtures/**' --ignore-pattern '**/dist/**' --ignore-pattern 'tools/**' --max-warnings 0",
    "lint:fixtures": "node lint/check-fixtures.mjs",
    "test": "vitest run",
    "build": "pnpm --filter @agent-greenhouse/sample build",
    "verify": "node scripts/verify.mjs",
    "verify:review": "node scripts/verify-review.mjs",
    "deps:update": "node scripts/update-deps.mjs"
  },
  "devDependencies": {
    "@agent-greenhouse/framework": "workspace:*",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
