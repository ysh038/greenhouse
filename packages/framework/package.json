{
  "name": "@agent-greenhouse/framework",
  "version": "0.1.0",
  "description": "에이전트가 쓴 React 화면 코드를 믿을 수 있게 하는 얇은 프레임워크: 안전한 API, 그것만 쓰게 하는 린트 규칙, 화면 검증",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysh038/greenhouse.git",
    "directory": "packages/framework"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "greenhouse": "./bin/greenhouse.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test.mjs",
    "!src/**/fixtures",
    "lint",
    "!lint/**/*.test.mjs",
    "cli",
    "bin",
    "vite",
    "vitest",
    "template",
    "tsconfig.base.json",
    "GUIDE.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./eslint": "./lint/config.mjs",
    "./stylelint": "./lint/stylelint.mjs",
    "./vite": {
      "types": "./vite/index.d.mts",
      "default": "./vite/index.mjs"
    },
    "./vitest": {
      "types": "./vitest/preset.d.mts",
      "default": "./vitest/preset.mjs"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./*": "./src/*/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./eslint": "./lint/config.mjs",
      "./stylelint": "./lint/stylelint.mjs",
      "./vite": {
        "types": "./vite/index.d.mts",
        "default": "./vite/index.mjs"
      },
      "./vitest": {
        "types": "./vitest/preset.d.mts",
        "default": "./vitest/preset.mjs"
      },
      "./tsconfig.base.json": "./tsconfig.base.json",
      "./*": {
        "types": "./dist/*/index.d.ts",
        "default": "./dist/*/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@testing-library/dom": ">=10.0.0",
    "@testing-library/react": ">=16.0.0",
    "eslint": ">=10.0.0",
    "jsdom": ">=26.0.0",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0",
    "stylelint": ">=18.0.0",
    "vite": ">=8.0.0",
    "vitest": ">=5.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.107.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "react-router": "^8.5.2",
    "typescript-eslint": "^8.73.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^18.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
