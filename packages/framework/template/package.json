    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "stylelint": "^18.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
